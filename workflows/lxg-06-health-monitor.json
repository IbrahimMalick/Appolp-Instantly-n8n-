    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// LXG-06 · Keep only the LXG workflows from the n8n API response.\nconst data = ($input.first().json.data) || [];\nconst api = $env.N8N_INTERNAL_API_URL || 'http://localhost:5678/api/v1';\nreturn data.filter(w => /^LXG - /.test(w.name)).map(w => ({ json: {\n  id: w.id, name: w.name, active: !!w.active,\n  urlSuccess: `${api}/executions?limit=1&status=success&workflowId=${w.id}`,\n  urlError: `${api}/executions?limit=1&status=error&workflowId=${w.id}`\n} }));\n"
      },
      "id": "5dd4b90f-151e-5ed6-a6f6-c2a059c6d33b",
      "name": "Filter LXG Workflows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
