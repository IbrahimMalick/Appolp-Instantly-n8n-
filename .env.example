# ─────────────────────────────────────────────────────────────────────────────
# LXG outreach automation — environment template.
# Copy to `.env` (never commit it).  API keys for Apollo / Instantly / Google /
# SMTP are NOT stored here: enter them as n8n Credentials in the n8n UI
# (they are encrypted with N8N_ENCRYPTION_KEY).  See SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n hosting ──────────────────────────────────────────────────────────────
# Pin a version you have tested (https://hub.docker.com/r/n8nio/n8n/tags). Workflows were built for n8n 1.x.
N8N_VERSION=1.123.84
# Public hostname that points at this server (DNS A record). Caddy gets a TLS cert for it automatically.
N8N_HOST=n8n.example.com
GENERIC_TIMEZONE=Europe/London
# Generate with:  openssl rand -hex 32   — BACK THIS UP: without it saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
# Used by the Health Monitor to read execution history (inside the container, leave as is).
N8N_INTERNAL_API_URL=http://localhost:5678/api/v1
# Keep execution history for 30 days (hours).
EXECUTIONS_DATA_MAX_AGE=720

# ── Google Sheet ─────────────────────────────────────────────────────────────
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# ── Safety switches ──────────────────────────────────────────────────────────
# DRY_RUN=true  => LXG-03 only LOGS what it would enrol; the reply handler never sends acknowledgements.
# Set to false ONLY after the client has approved go-live (see SETUP.md "Go-live checklist").
DRY_RUN=true

# ── Lead source (LXG-01) ─────────────────────────────────────────────────────
# csv        = read CSV files dropped in ./import  (works on any Apollo plan)
# apollo_api = call Apollo's API (needs an API-enabled plan + master API key; see docs/apollo-setup.md)
LEAD_SOURCE_MODE=csv
# Max new prospects written to the Intake tab per run (ramp-up control).
APOLLO_MAX_PER_RUN=50

# ── Qualification (LXG-02) ───────────────────────────────────────────────────
# Comma-separated, lower-case. Add countries here to expand beyond the UK later.
ALLOWED_COUNTRIES=united kingdom,uk,great britain,gb,england,scotland,wales,northern ireland
# Apollo/CSV email status values accepted.
ALLOWED_EMAIL_STATUS=verified
REQUIRE_FIRST_NAME=true

# ── Enrolment & volume ramp (LXG-03) ─────────────────────────────────────────
# Start LOW on a new domain (e.g. 10-20/day) and raise gradually as warm-up completes.
DAILY_ENROLL_CAP=20
ENROLL_BATCH_SIZE=10
MAX_ENROLL_ATTEMPTS=3
# Instantly campaign id used when no segment-specific campaign matches (find it in the Instantly campaign URL).
INSTANTLY_CAMPAIGN_ID_DEFAULT=
# Optional: route segments to different campaigns. JSON, segments: golf, clubs, equestrian, motorsport, sailing,
# fitness, hospitality_gift, sporting_goods, menswear, lifestyle_retail.   Example:
# INSTANTLY_CAMPAIGN_MAP={"golf":"<campaign-id>","fitness":"<campaign-id>"}
INSTANTLY_CAMPAIGN_MAP={}
# Number of emails in the sequence (Day 1, Day 4, Day 9 => 3).
SEQUENCE_STEPS=3

# ── Reply handler (LXG-04) ───────────────────────────────────────────────────
# Long random string. Put the same value in the Instantly webhook URL:  ...?token=<this value>
INSTANTLY_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-24
# Automatic acknowledgement after a reply. Keep false until the client supplies + approves the copy
# (edit ACK_SUBJECT / ACK_BODY in the "Decide Action" node of LXG - 04).
ACK_ENABLED=false

# ── Alerts & reports (LXG-05/06/99) ──────────────────────────────────────────
# Owner mailbox that receives alerts + the weekly summary.
ALERT_EMAIL_TO=owner@example.com
# Sender for alerts. Use a normal business mailbox that is NOT one of the cold-outreach mailboxes.
ALERT_EMAIL_FROM=lxg-automation@example.com
# Optional: send the weekly report to someone else.
REPORT_EMAIL_TO=
REPORT_WINDOW_DAYS=7
ALERT_THROTTLE_HOURS=24
# Optional free "dead-man's switch" (e.g. a healthchecks.io check URL). Pinged hourly by LXG-06; if pings stop,
# that service emails you — this covers the case where n8n itself is down. Leave empty to disable.
HEARTBEAT_PING_URL=
